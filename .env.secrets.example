# ============================================================
# academic-spiders 敏感配置仓库模板 (可提交, 占位符)
#
# 用法: cp .env.secrets.example .env.secrets 后填入真实值。
# 本文件只作示例, 切勿填入真实密钥。
# ============================================================

# ── 本地测试模式 (academicdb_test @ localhost) ───────────────
[test]
MYSQL_PASSWORD=xxx

# ── 本地开发模式 (academicdb @ localhost) ────────────────────
[dev]
MYSQL_PASSWORD=xxx

# ── 远程生产模式 (pubscholar @ 远程主机) ─────────────────────
[prod]
MYSQL_HOST=xxx
MYSQL_USER=xxx
MYSQL_PASSWORD=xxx
