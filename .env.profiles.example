# ============================================================
# academic-spiders 运行模式 Profile 仓库模板 (可提交, 用占位符)
#
# 用法:
#   1) cp .env.profiles.example .env.profiles
#   2) 填入真实密钥 (MYSQL_PASSWORD 等)
#   3) python env.py list / python env.py current / python env.py switch <test|dev|prod>
#
# 每段为一个完整可写入 .env 的配置块; 三种模式的键集合应保持一致。
# ACADEMIC_MODE 是模式标记 (env.py 会据此写入 .env, 供日志目录分流等判断)。
# ============================================================

# ── 本地测试模式 (academicdb_test @ localhost) ───────────────
[test]
ACADEMIC_MODE=test
V1_BUCKET_MODE=1
V1_BUCKET_THRESHOLD=9900
V1_BUCKET_FORCE_PLAN=0
MYSQL_HOST=localhost
MYSQL_PASSWORD=xxx
MYSQL_DATABASE=academicdb_test
ACADEMIC_JSON_OUTPUT=xxx

# ── 本地开发模式 (academicdb @ localhost) ────────────────────
[dev]
ACADEMIC_MODE=dev
V1_BUCKET_MODE=1
V1_BUCKET_THRESHOLD=9900
V1_BUCKET_FORCE_PLAN=0
MYSQL_HOST=localhost
MYSQL_PASSWORD=xxx
MYSQL_DATABASE=academicdb
ACADEMIC_JSON_OUTPUT=xxx

# ── 远程生产模式 (pubscholar @ 远程主机) ─────────────────────
[prod]
ACADEMIC_MODE=prod
V1_BUCKET_MODE=1
V1_BUCKET_THRESHOLD=9900
V1_BUCKET_FORCE_PLAN=0
MYSQL_HOST=xxx
MYSQL_PASSWORD=xxx
MYSQL_DATABASE=pubscholar
ACADEMIC_JSON_OUTPUT=xxx
